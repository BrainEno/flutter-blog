<?xml version="1.0" encoding="utf-8"?>
<!--
  Kept even though allowBackup is false: older Android backup parsers and
  vendor tools can inspect this explicit deny-list. No app-private data is a
  safe restore payload because belog.sqlite can contain fallback credentials,
  drafts, queued authoring writes, reading history and cached article text.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
