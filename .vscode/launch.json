{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
        "name": "Flutter: Attach to Device",
        "type": "dart",
        "request": "attach"
    },
        {
            "name": "belog",
            "request": "launch",
            "type": "dart",
            // Reads the same public origins as the launcher scripts. Copy
            // env.example.json to env.json first; without it the app now
            // shows a startup-failure screen instead of a blank window.
            "toolArgs": [
                "--dart-define-from-file=env.json",
                "--dart-define=BELOG_DEV_BACKEND_CHECK=true"
            ]
        },
        {
            "name": "belog (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "belog (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}